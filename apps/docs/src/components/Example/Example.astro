---
import SvelteWrapper from './SvelteWrapper.svelte'
import Code from '../Code/Code.astro'
import CodeWrapper from './CodeWrapper.svelte'
import { getAllExamplesModules } from './globLoader'

interface Props {
  /**
   * The path to the entry App.svelte file relative to src/examples
   */
  path: string
  hideCode?: boolean
  hidePreview?: boolean
  iframe?: boolean
  showFile?: string
  expandCode?: boolean
  previewClass?: string
  hideStackblitz?: boolean
}

const allModules = getAllExamplesModules()

/**
 * Multi-step examples may keep files that are identical in every step in a
 * `shared` directory next to the step directories. Those files are bundled
 * with every step and are imported as e.g. `../shared/Component.svelte`.
 */
const parentDir = Astro.props.path.split('/').slice(0, -1).join('/')
const sharedPrefix = parentDir ? `${parentDir}/shared/` : ''

const relativize = (key: string) => {
  const path = key.replace('../../examples/', '')
  if (path.startsWith(Astro.props.path + '/')) {
    return path.slice(Astro.props.path.length + 1)
  }
  // a file from the sibling `shared` directory
  return `../shared/${path.slice(sharedPrefix.length)}`
}

const filteredModules = Object.fromEntries(
  Object.entries(allModules).filter(([key]) => {
    const path = key.replace('../../examples/', '')
    return (
      path.startsWith(Astro.props.path + '/') || (sharedPrefix && path.startsWith(sharedPrefix))
    )
  })
)

const files: Record<string, string> = {}
for (const path in filteredModules) {
  files[relativize(path)] = filteredModules[path] as string
}

const hideCode = Astro.props.hideCode ?? false
const hidePreview = Astro.props.hidePreview ?? false
---

<>
  {
    !hidePreview && (
      <SvelteWrapper
        hideStackblitz={Astro.props.hideStackblitz}
        class={Astro.props.previewClass}
        hideCode={hideCode}
        path={Astro.props.path}
        client:load
        files={files}
        iframe={Astro.props.iframe ?? true}
      />
    )
  }

  {
    !hideCode && (
      <CodeWrapper
        showFile={Astro.props.showFile}
        expanded={hidePreview || (Astro.props.expandCode ?? false)}
        hidePreview={hidePreview}
        client:load
        filePaths={Object.keys(filteredModules).map(relativize)}
      >
        {Object.entries(filteredModules).map(([path, mod]) => (
          <div
            data-path={relativize(path)}
            class="h-full"
          >
            <Code
              code={mod}
              lang={(path.split('.').pop() ?? 'svelte') as any}
              class="mt-0! mb-0! h-full rounded-none border-none"
            />
          </div>
        ))}
      </CodeWrapper>
    )
  }
</>
